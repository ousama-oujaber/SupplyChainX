# Production Environment Variables Template
# Copy this file to .env and fill in your actual values

# ===================================
# Docker Hub Configuration
# ===================================
DOCKER_HUB_USERNAME=your-dockerhub-username
IMAGE_TAG=backend

# ===================================
# MySQL Configuration
# ===================================
MYSQL_ROOT_PASSWORD=your-strong-root-password-here
MYSQL_DATABASE=supplychainx
MYSQL_USER=scx_user
MYSQL_PASSWORD=your-strong-mysql-password-here

# ===================================
# Keycloak Database Configuration
# ===================================
KEYCLOAK_DB_PASSWORD=your-strong-keycloak-db-password-here

# ===================================
# Keycloak Configuration
# ===================================
# Use your droplet IP or domain name
KEYCLOAK_HOSTNAME=your-droplet-ip-or-domain.com
KEYCLOAK_PORT=8090
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=your-strong-keycloak-admin-password-here

# ===================================
# Application Configuration
# ===================================
APP_PORT=8080

# ===================================
# Optional: Email Configuration
# ===================================
# SPRING_MAIL_HOST=smtp.gmail.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=your-email@gmail.com
# SPRING_MAIL_PASSWORD=your-app-password
