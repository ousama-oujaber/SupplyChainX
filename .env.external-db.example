# Environment Variables for External Database Deployment
# Copy this file to .env and replace with your actual values

# ===================================
# Docker Hub Configuration
# ===================================
DOCKER_HUB_USERNAME=your-dockerhub-username
IMAGE_TAG=backend

# ===================================
# External Database Configuration
# ===================================
DB_HOST=your-database-ip-or-hostname
DB_PORT=3306
DB_NAME=supplychainx
DB_USER=your-db-username
DB_PASSWORD=your-strong-db-password

# ===================================
# External Keycloak Configuration
# ===================================
KEYCLOAK_URL=http://your-keycloak-server:8090/realms/supplychainx

# ===================================
# Application Configuration
# ===================================
APP_PORT=8080

# ===================================
# CORS Configuration
# ===================================
# Comma-separated list of allowed origins
# Include your proxy server, frontend server, and domain
CORS_ALLOWED_ORIGINS=http:/localhost:4200,https:/localhost:4200,http://localhost:8080,https://localhost:8080

# ===================================
# Optional: Email Configuration
# ===================================
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-app-password
